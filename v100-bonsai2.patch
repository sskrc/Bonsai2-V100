+// ---------------------------------------------------------------------------
+// Lane-group PTQ1_0 mat-vec for 2-4 columns on Volta (LW).
+//
+// The planar kernel above keeps one fp32 partial per (row, column, K block) in shared memory, which
+// caps a CTA at a few rows when K is long (ffn_down, K = 17408: 4 rows at 4 columns). Every CTA then
+// streams the whole activation set (ncols * K * 9/8 bytes, 78 KB at 4 x 17408) from L2 for 4 rows of
+// weights (15 KB): on a V100 that is ~100 MB of L2 traffic per ffn_down call at verify width 4 and
+// the kernel runs at the L2 limit (72 us, 3x the weight-streaming time).
+// Here LPR lanes own one group of ROWS rows and stride over K, accumulating in registers, then
+// reduce with shuffles. No shared memory is used, so L1 keeps the activations, and all warps of an SM
+// walk K in step, so they hit the same activation lines. The per-block arithmetic is
+// ptq1_0_pt_block_dot, on the same PT activation layout.
+// ---------------------------------------------------------------------------
+#define PTQ1_0_LW_THREADS 128
+
+template <int ncols, int ROWS, int LPR, bool has_fusion, bool has_gate>
+__launch_bounds__(PTQ1_0_LW_THREADS, (ncols*ROWS >= 12 ? 3 : 4))
+static __global__ void mul_mat_vec_ptq1_0_lw(
+        const void * vx_, const void * vy_, const ggml_cuda_mm_fusion_args_device fusion,
+        float * dst_,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        const int ngroups) {
+    const void * GGML_CUDA_RESTRICT vx = vx_;
+    const void * GGML_CUDA_RESTRICT vy = vy_;
+    float      * GGML_CUDA_RESTRICT dst = dst_;
+    ggml_cuda_pdl_sync();
+
+    const int bpr  = ncols_x / QK_PTQ1_0;
+    const int nblk = ptq1_0_pt_nblk(ncols_x);
+    const int lg   = threadIdx.x % LPR;
+    const int rg   = (blockIdx.x*PTQ1_0_LW_THREADS + threadIdx.x) / LPR;
+    const int rgc  = rg < ngroups ? rg : ngroups - 1; // past-the-end groups recompute the last one, not stored
+
+    const char * ycol[ncols];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        ycol[j] = (const char *) ((const block_q8_1 *) vy + j*stride_col_y);
+    }
+
+    const block_ptq1_0 * row_x[ROWS];
+    [[maybe_unused]] const block_ptq1_0 * row_g[ROWS];
+#pragma unroll
+    for (int i = 0; i < ROWS; ++i) {
+        int r = rgc*ROWS + i;
+        r = r < nrows_x ? r : nrows_x - 1;
+        row_x[i] = (const block_ptq1_0 *) vx + (int64_t) r*stride_row_x;
+        if constexpr (has_gate) {
+            row_g[i] = (const block_ptq1_0 *) fusion.gate + (int64_t) r*stride_row_x;
+        }
+    }
+
+    float acc[ncols][ROWS];
+    [[maybe_unused]] float accg[ncols][ROWS];
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+        for (int i = 0; i < ROWS; ++i) {
+            acc[j][i] = 0.0f;
+            if constexpr (has_gate) {
+                accg[j][i] = 0.0f;
+            }
+        }
+    }
+
+    for (int kb = lg; kb < bpr; kb += LPR) {
+        const block_ptq1_0 * bq[ROWS];
+#pragma unroll
+        for (int i = 0; i < ROWS; ++i) {
+            bq[i] = row_x[i] + kb;
+        }
+        float dots[ncols][ROWS];
+        ptq1_0_pt_block_dot<ncols, ROWS>(bq, ycol, kb, nblk, dots);
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+            for (int i = 0; i < ROWS; ++i) {
+                acc[j][i] += dots[j][i];
+            }
+        }
+        if constexpr (has_gate) {
+#pragma unroll
+            for (int i = 0; i < ROWS; ++i) {
+                bq[i] = row_g[i] + kb;
+            }
+            ptq1_0_pt_block_dot<ncols, ROWS>(bq, ycol, kb, nblk, dots);
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+                for (int i = 0; i < ROWS; ++i) {
+                    accg[j][i] += dots[j][i];
+                }
+            }
+        }
+    }
+
+    // every lane leaves the K loop before the shuffles, so the full-warp mask is valid
+#pragma unroll
+    for (int off = LPR/2; off > 0; off >>= 1) {
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+            for (int i = 0; i < ROWS; ++i) {
+                acc[j][i] += __shfl_xor_sync(0xffffffff, acc[j][i], off, WARP_SIZE);
+                if constexpr (has_gate) {
+                    accg[j][i] += __shfl_xor_sync(0xffffffff, accg[j][i], off, WARP_SIZE);
+                }
+            }
+        }
+    }
+
+    if (lg != 0 || rg >= ngroups) {
+        return;
+    }
+#pragma unroll
+    for (int i = 0; i < ROWS; ++i) {
+        const int row = rg*ROWS + i;
+        if (row >= nrows_x) {
+            break;
+        }
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            float result = acc[j][i];
+            if constexpr (has_fusion) {
+                if (fusion.x_bias) {
+                    result += ((const float *) fusion.x_bias)[j*stride_col_dst + row];
+                }
+                if constexpr (has_gate) {
+                    float gate_value = accg[j][i];
+                    if (fusion.gate_bias) {
+                        gate_value += ((const float *) fusion.gate_bias)[j*stride_col_dst + row];
+                    }
+                    switch (fusion.glu_op) {
+                        case GGML_GLU_OP_SWIGLU:
+                            result *= ggml_cuda_op_silu_single(gate_value);
+                            break;
+                        case GGML_GLU_OP_GEGLU:
+                            result *= ggml_cuda_op_gelu_single(gate_value);
+                            break;
+                        case GGML_GLU_OP_SWIGLU_OAI:
+                            result = ggml_cuda_op_swiglu_oai_single(gate_value, result);
+                            break;
+                        default:
+                            result = result * gate_value;
+                            break;
+                    }
+                }
+            }
+            dst[j*stride_col_dst + row] = result;
+        }
+    }
+}
+
+template <int ncols, int ROWS, int LPR>
+static void mul_mat_vec_ptq1_0_lw_launch(
+        const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        cudaStream_t stream) {
+    const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr;
+    const bool has_gate   = fusion.gate != nullptr;
+    const int  ngroups    = (nrows_x + ROWS - 1) / ROWS;
+    const dim3 block_nums((ngroups*LPR + PTQ1_0_LW_THREADS - 1) / PTQ1_0_LW_THREADS, 1, 1);
+    const dim3 block_dims(PTQ1_0_LW_THREADS, 1, 1);
+    const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+#define PTQ1_0_LW_LAUNCH(FUS, GATE)                                                       \
+    ggml_cuda_kernel_launch(mul_mat_vec_ptq1_0_lw<ncols, ROWS, LPR, FUS, GATE>, lp,       \
+        vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, ngroups)
+    if (has_gate) {
+        PTQ1_0_LW_LAUNCH(true, true);
+    } else if (has_fusion) {
+        PTQ1_0_LW_LAUNCH(true, false);
+    } else {
+        PTQ1_0_LW_LAUNCH(false, false);
+    }
+#undef PTQ1_0_LW_LAUNCH
+}
+
+// GGML_CUDA_PTQ1_LW: unset = automatic choice on Volta, 0 = off (planar kernel), or one geometry for
+// experiments: 28 / 48 = ROWS 2 / 4 with LPR 8, 216 / 416 = ROWS 2 / 4 with LPR 16
+static int ggml_cuda_ptq1_0_lw_mode() {
+    static const int mode = [] {
+        const char * e = getenv("GGML_CUDA_PTQ1_LW");
+        return e ? atoi(e) : -1;
+    }();
+    return mode;
+}
+
+template <int ncols>
+static bool mul_mat_vec_ptq1_0_lw_dispatch(
+        const int rl, const void * vx, const void * vy, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        cudaStream_t stream) {
+#define PTQ1_0_LW_CASE(R, L) \
+    case R*10 + L: mul_mat_vec_ptq1_0_lw_launch<ncols, R, L>(vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return true;
+    switch (rl) {
+        PTQ1_0_LW_CASE(2, 8)
+        PTQ1_0_LW_CASE(4, 8)
+        default: break;
+    }
+    switch (rl) {
+        case 216: mul_mat_vec_ptq1_0_lw_launch<ncols, 2, 16>(vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return true;
+        case 416: mul_mat_vec_ptq1_0_lw_launch<ncols, 4, 16>(vx, vy, fusion, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); return true;
+        default: return false;
+    }
+#undef PTQ1_0_LW_CASE
+}
+
+// automatic choice, from V100 measurements at the Ternary Bonsai 27B shapes (us, planar -> LW):
+//   K = 17408 ffn_down   n=2: 53.8 -> 44.7   n=3: 55.1 -> 51.6   n=4: 72.5 -> 48-54   (ROWS 2, LPR 16)
+//   K = 6144  ssm_out    n=2: 19.1 -> 15.1   n=3: 24.1 -> 17.4   n=4: 27.1 -> 20.2   (ROWS 2, LPR 16)
+//   K = 5120, 10240 rows n=2: 27.3 -> 26.0   n=3: 31.2 -> 29.1   n=4: 34.4 -> 29.8   (ROWS 2, LPR 8)
+//   K = 5120, 17408 rows n=2: 38.4 -> 42.3   n=3: 45.3 -> 46.6   n=4: 50.7 -> 46.8   (planar wins below 4)
+// Returns the GGML_CUDA_PTQ1_LW code, or 0 to keep the planar kernel.
+static int ptq1_0_lw_auto(const int bpr, const int nrows_x, const int ncols_dst) {
+    if (bpr >= 48) {
+        return 216;
+    }
+    if (ncols_dst == 4 || nrows_x <= 10240) {
+        return 28;
+    }
+    return 0;
+}
